$TTL 60

@   IN  SOA ns1.example.internal. admin.example.internal. (
            2024010101  ; serial
            3600        ; refresh
            900         ; retry
            604800      ; expire
            60 )        ; minimum TTL

    IN  NS  ns1.example.internal.

; nameserver
ns1     IN  A   127.0.0.1

; dummy records
www     IN  A   192.0.2.1
mail    IN  A   192.0.2.2

; dedicated record for the health check
health  IN  A   127.0.0.1
